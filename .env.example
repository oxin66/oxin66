# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL_HERE"

# Supabase Anonymous Key (publicly safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# Supabase Service Role Key (secret, for admin tasks, use with caution on server-side)
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# NowPayments API Key (if you plan to use it)
# NOWPAYMENTS_API_KEY="YOUR_NOWPAYMENTS_API_KEY_HERE"

# Add other environment variables your project might need
# Example:
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
